---
import Layout from "../../layouts/Layout.astro";
import BookCard from "../../components/BookCard.astro";
import { slugify } from "../../lib/slug";
import { getBooks, tagCounts, type Book } from "../../lib/books";
import { SITE_NAME } from "../../lib/site";

export async function getStaticPaths() {
  const books = await getBooks();
  return tagCounts(books).map(({ tag }) => ({
    params: { tag: slugify(tag) },
    props: { tag, books: books.filter((b) => b.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  books: Book[];
}

const { tag, books } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={`${tag} — ${SITE_NAME}`} description={`Book reviews about ${tag.toLowerCase()} on ${SITE_NAME}.`}>
  <nav class="crumbs" aria-label="Breadcrumbs">
    <a href={base}>All books</a> <span aria-hidden="true">/</span> <a href={`${base}tag/`}>Topics</a>
  </nav>
  <h1 class="page-title">{tag}</h1>
  <p class="page-lead">{books.length} {books.length === 1 ? "book" : "books"} on this topic.</p>
  <ul class="shelf-grid">
    {books.map((book) => <BookCard book={book} />)}
  </ul>
</Layout>
