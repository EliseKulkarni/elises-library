---
import Layout from "../../layouts/Layout.astro";
import { slugify } from "../../lib/slug";
import { getBooks, tagCounts } from "../../lib/books";
import { SITE_NAME } from "../../lib/site";

const tags = tagCounts(await getBooks());
const base = import.meta.env.BASE_URL;
---
<Layout title={`Topics — ${SITE_NAME}`} description={`All the topics on ${SITE_NAME}, with the number of books reviewed for each.`}>
  <nav class="crumbs" aria-label="Breadcrumbs">
    <a href={base}>&larr; All books</a>
  </nav>
  <h1 class="page-title">Topics</h1>
  <p class="page-lead">Browse the books by what they’re about.</p>
  <ul class="theme-index">
    {tags.map(({ tag, count }) => (
      <li>
        <a href={`${base}tag/${slugify(tag)}/`}>{tag}</a>
        <span class="count">{count} {count === 1 ? "book" : "books"}</span>
      </li>
    ))}
  </ul>
</Layout>
